rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function admin() {
      return logado() && request.auth.token.email == 'matheusernandes09@gmail.com';
    }
    function membro() {
      return admin() || (logado() &&
        exists(/databases/$(database)/documents/membros/$(request.auth.token.email)));
    }
    // questões, figuras, materiais, provas e modelos do grupo
    match /dados/{item} {
      allow read: if membro();
      allow create, update: if membro() && request.resource.data.t == request.time;
      allow delete: if admin();
    }
    // livros SESI: índice por série e texto dos capítulos (só o administrador envia)
    match /livros/{item} {
      allow read: if membro();
      allow write: if admin();
    }
    // professores liberados (só o administrador inclui ou remove)
    match /membros/{email} {
      allow read: if membro() || (logado() && request.auth.token.email == email);
      allow write: if admin();
    }

    // ===== Gabarito (correção de provas) =====
    // Cada professor liberado só lê e altera os próprios dados.
    match /gab_perfis/{uid} {
      allow read, write: if membro() && request.auth.uid == uid;
    }
    match /gab_turmas/{id} {
      allow read, delete: if membro() && resource.data.dono == request.auth.uid;
      allow create: if membro() && request.resource.data.dono == request.auth.uid;
      allow update: if membro() && resource.data.dono == request.auth.uid && request.resource.data.dono == request.auth.uid;
    }
    match /gab_avaliacoes/{id} {
      allow read, delete: if membro() && resource.data.dono == request.auth.uid;
      allow create: if membro() && request.resource.data.dono == request.auth.uid;
      allow update: if membro() && resource.data.dono == request.auth.uid && request.resource.data.dono == request.auth.uid;
    }
    match /gab_resultados/{id} {
      allow read, delete: if membro() && resource.data.dono == request.auth.uid;
      allow create: if membro() && request.resource.data.dono == request.auth.uid;
      allow update: if membro() && resource.data.dono == request.auth.uid && request.resource.data.dono == request.auth.uid;
    }
  }
}
